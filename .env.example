# LLM_ENV picks which provider the pipeline calls — defaults to "dev" so nobody
# accidentally spends real money just by running the app.
#   dev  (default): OpenRouter's free-tier GLM 5.2 — $0 cost, for iteration.
#   prod: Together.ai's DeepSeek V4 Pro — the real model, for actual runs and
#         the Phase 11 evaluation numbers.
LLM_ENV=dev

# Needed for LLM_ENV=dev (the default).
OPENROUTER_API_KEY=

# Needed for LLM_ENV=prod.
TOGETHER_API_KEY=

# Only needed if you're not using the default local-dev Postgres (localhost:5433,
# matching docker/docker-compose.yml's exposed port — deliberately not 5432, to
# avoid colliding with a native Postgres install on the host). The containerized
# backend gets its own DATABASE_URL from docker-compose.yml directly, not this file.
# DATABASE_URL=postgresql+asyncpg://auth_logic_hunter:auth_logic_hunter@localhost:5433/auth_logic_hunter
